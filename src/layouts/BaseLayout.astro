---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = 'Chloe Chan' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@400;500&family=Baloo+2:wght@600;700&family=Gaegu:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      as="image"
      href="/images/hero/background-1600.webp"
      imagesrcset="/images/hero/background-800.webp 800w, /images/hero/background-1200.webp 1200w, /images/hero/background-1600.webp 1600w, /images/hero/background-2400.webp 2400w, /images/hero/background-3200.webp 3200w, /images/hero/background-4096.webp 4096w"
      imagesizes="164vw"
      fetchpriority="high"
    />
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              brand: 'var(--color-brand)',
              accent: 'var(--color-accent)',
            },
            fontFamily: {
              sans: 'var(--font-sans)',
              serif: 'var(--font-serif)',
            },
          },
        },
      };
    </script>
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-text)] font-sans antialiased">
    <slot name="nav" />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // Smooth-scroll for all in-page anchor links (nav, dropdowns, mobile menu)
  document.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const href = (link as HTMLAnchorElement).getAttribute('href');
      if (!href) return;

      const target = document.querySelector(href);
      if (!target) return;

      e.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // Close desktop dropdowns when clicking outside a nav group
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('.group')) {
      document.querySelectorAll('.dropdown').forEach((d) => {
        (d as HTMLElement).style.opacity = '';
        (d as HTMLElement).style.visibility = '';
      });
    }
  });
</script>
