---
// The hero is one big illustration treated as a 4096×1714 coordinate space.
// Every sprite is placed with left/top/width percentages of that canvas (via
// --x/--y/--w custom properties), so the whole scene scales together. See
// global.css for the desktop wide-crop math and the mobile portrait layout
// that overrides it via --x-mobile/--y-mobile/--w-mobile.
---

<section id="top" class="hero-section">
  <div class="hero-stage" id="heroStage">

    <!-- Background wash -->
    <picture class="hero-bg">
      <source
        type="image/avif"
        srcset="
          /images/hero/background-800.avif 800w,
          /images/hero/background-1200.avif 1200w,
          /images/hero/background-1600.avif 1600w,
          /images/hero/background-2400.avif 2400w,
          /images/hero/background-3200.avif 3200w,
          /images/hero/background-4096.avif 4096w"
        sizes="164vw"
      />
      <source
        type="image/webp"
        srcset="
          /images/hero/background-800.webp 800w,
          /images/hero/background-1200.webp 1200w,
          /images/hero/background-1600.webp 1600w,
          /images/hero/background-2400.webp 2400w,
          /images/hero/background-3200.webp 3200w,
          /images/hero/background-4096.webp 4096w"
        sizes="164vw"
      />
      <img src="/images/hero/background-1600.png" width="4096" height="1714" alt="" fetchpriority="high" decoding="async" />
    </picture>

    <!-- Headline text -->
    <div class="hero-text" style="--x:32.53%; --y:27.25%; --w:16%; --x-mobile:8%; --y-mobile:20%; --w-mobile:84%;">
      <p class="hero-text__title">Hi, I&rsquo;m<br />Chloe!</p>
      <p class="hero-text__tagline">designer <span class="hero-text__star">✦</span> developer <span class="hero-text__star">✦</span> artist</p>
    </div>

    <!-- Claw (no bob — scroll-linked descent instead) -->
    <picture class="sprite sprite--claw" id="heroClaw" style="--x:20.07%; --y:8%; --w:11.67%; --x-mobile:3%; --y-mobile:0%; --w-mobile:14%;">
      <source type="image/avif" srcset="/images/hero/sprites/claw.avif" />
      <source type="image/webp" srcset="/images/hero/sprites/claw.webp" />
      <img src="/images/hero/sprites/claw.png" width="485" height="1256" alt="" loading="eager" decoding="async" />
    </picture>

    <!-- Sprites + icons share a wrapper so scroll inertia / cursor magnet
         (this component's script below) can move them individually
         without touching bg/text/claw -->
    <div class="hero-sprites" id="heroSprites">

      <!-- Decorative bobbing sprites -->
      <picture class="sprite wiggle-sprite bob-a" style="--x:59.55%; --y:38.33%; --w:18.95%; --bob-dur:7.4s; --bob-delay:-2.1s; --inertia-kick:0.20; --inertia-friction:0.90; --inertia-max:30; --x-mobile:14%; --y-mobile:44%; --w-mobile:26%;">
        <source type="image/avif" srcset="/images/hero/sprites/bear.avif" />
        <source type="image/webp" srcset="/images/hero/sprites/bear.webp" />
        <img src="/images/hero/sprites/bear.png" width="776" height="1057" alt="" loading="eager" decoding="async" />
      </picture>

      <picture class="sprite wiggle-sprite bob-b" style="--x:17.75%; --y:57.00%; --w:12.99%; --bob-dur:5.6s; --bob-delay:-0.6s; --inertia-kick:0.42; --inertia-friction:0.78; --inertia-max:26; --x-mobile:17%; --y-mobile:64%; --w-mobile:20%;">
        <source type="image/avif" srcset="/images/hero/sprites/bunny.avif" />
        <source type="image/webp" srcset="/images/hero/sprites/bunny.webp" />
        <img src="/images/hero/sprites/bunny.png" width="532" height="733" alt="" loading="eager" decoding="async" />
      </picture>

      <picture class="sprite wiggle-sprite bob-c hero-hide-mobile" style="--x:77.20%; --y:67.27%; --w:10.94%; --bob-dur:6.5s; --bob-delay:-3.4s; --inertia-kick:0.16; --inertia-friction:0.93; --inertia-max:28;">
        <source type="image/avif" srcset="/images/hero/sprites/cat.avif" />
        <source type="image/webp" srcset="/images/hero/sprites/cat.webp" />
        <img src="/images/hero/sprites/cat.png" width="448" height="536" alt="" loading="eager" decoding="async" />
      </picture>

      <picture class="sprite wiggle-sprite bob-d" style="--x:46.58%; --y:57.88%; --w:16.16%; --bob-dur:6.9s; --bob-delay:-1.8s; --inertia-kick:0.30; --inertia-friction:0.84; --inertia-max:24; --x-mobile:62%; --y-mobile:44%; --w-mobile:22%;">
        <source type="image/avif" srcset="/images/hero/sprites/girl.avif" />
        <source type="image/webp" srcset="/images/hero/sprites/girl.webp" />
        <img src="/images/hero/sprites/girl.png" width="662" height="705" alt="" loading="eager" decoding="async" />
      </picture>

      <picture class="sprite wiggle-sprite bob-e" style="--x:29.64%; --y:68.84%; --w:10.64%; --bob-dur:5.2s; --bob-delay:-2.7s; --inertia-kick:0.46; --inertia-friction:0.75; --inertia-max:20; --x-mobile:64%; --y-mobile:64%; --w-mobile:18%;">
        <source type="image/avif" srcset="/images/hero/sprites/penguin.avif" />
        <source type="image/webp" srcset="/images/hero/sprites/penguin.webp" />
        <img src="/images/hero/sprites/penguin.png" width="436" height="534" alt="" loading="eager" decoding="async" />
      </picture>

      <picture class="sprite wiggle-sprite bob-b hero-hide-mobile" style="--x:6.20%; --y:74.21%; --w:11.79%; --bob-dur:8.1s; --bob-delay:-4.0s; --inertia-kick:0.50; --inertia-friction:0.80; --inertia-max:18;">
        <source type="image/avif" srcset="/images/hero/sprites/flower1.avif" />
        <source type="image/webp" srcset="/images/hero/sprites/flower1.webp" />
        <img src="/images/hero/sprites/flower1.png" width="483" height="442" alt="" loading="eager" decoding="async" />
      </picture>

      <picture class="sprite wiggle-sprite bob-a hero-hide-mobile" style="--x:49.32%; --y:11.98%; --w:10.62%; --bob-dur:7.0s; --bob-delay:-1.1s; --inertia-kick:0.34; --inertia-friction:0.87; --inertia-max:22;">
        <source type="image/avif" srcset="/images/hero/sprites/flower2.avif" />
        <source type="image/webp" srcset="/images/hero/sprites/flower2.webp" />
        <img src="/images/hero/sprites/flower2.png" width="435" height="456" alt="" loading="eager" decoding="async" />
      </picture>

      <picture class="sprite wiggle-sprite bob-c hero-hide-mobile" style="--x:8.13%; --y:40.61%; --w:7.18%; --bob-dur:4.6s; --bob-delay:-0.3s; --inertia-kick:0.55; --inertia-friction:0.73; --inertia-max:16;">
        <source type="image/avif" srcset="/images/hero/sprites/star1.avif" />
        <source type="image/webp" srcset="/images/hero/sprites/star1.webp" />
        <img src="/images/hero/sprites/star1.png" width="294" height="266" alt="" loading="eager" decoding="async" />
      </picture>

      <picture class="sprite wiggle-sprite bob-d hero-hide-mobile" style="--x:85.35%; --y:85.36%; --w:5.59%; --bob-dur:5.9s; --bob-delay:-3.0s; --inertia-kick:0.38; --inertia-friction:0.86; --inertia-max:20;">
        <source type="image/avif" srcset="/images/hero/sprites/star2.avif" />
        <source type="image/webp" srcset="/images/hero/sprites/star2.webp" />
        <img src="/images/hero/sprites/star2.png" width="229" height="203" alt="" loading="eager" decoding="async" />
      </picture>

      <picture class="sprite wiggle-sprite bob-e hero-hide-mobile" style="--x:61.16%; --y:10.75%; --w:5.05%; --bob-dur:6.3s; --bob-delay:-2.5s; --inertia-kick:0.60; --inertia-friction:0.77; --inertia-max:14;">
        <source type="image/avif" srcset="/images/hero/sprites/star3.avif" />
        <source type="image/webp" srcset="/images/hero/sprites/star3.webp" />
        <img src="/images/hero/sprites/star3.png" width="207" height="263" alt="" loading="eager" decoding="async" />
      </picture>

      <!-- Social icons: closed → open on hover/focus, clickable -->
      <a class="hero-icon wiggle-sprite" href="https://www.linkedin.com/in/chloe-chan-339819290" target="_blank" rel="noopener" aria-label="Chloe on LinkedIn"
         style="--x:28.45%; --y:89.26%; --w:9.97%; --x-mobile:15%; --y-mobile:87%; --w-mobile:13%; --magnet-strength:6;">
        <span class="hero-icon__bob bob-a" style="--bob-dur:5.4s; --bob-delay:-1.2s;">
          <picture class="hero-icon__img hero-icon__img--closed">
            <source type="image/avif" srcset="/images/hero/sprites/linkedin-closed.avif" />
            <source type="image/webp" srcset="/images/hero/sprites/linkedin-closed.webp" />
            <img src="/images/hero/sprites/linkedin-closed.png" width="400" height="400" alt="" loading="eager" decoding="async" />
          </picture>
          <picture class="hero-icon__img hero-icon__img--open">
            <source type="image/avif" srcset="/images/hero/sprites/linkedin-open.avif" />
            <source type="image/webp" srcset="/images/hero/sprites/linkedin-open.webp" />
            <img src="/images/hero/sprites/linkedin-open.png" width="400" height="400" alt="" loading="eager" decoding="async" />
          </picture>
        </span>
      </a>

      <a class="hero-icon wiggle-sprite" href="https://github.com/chloewychan/" target="_blank" rel="noopener" aria-label="Chloe on GitHub"
         style="--x:42.80%; --y:86.46%; --w:9.85%; --x-mobile:38%; --y-mobile:91%; --w-mobile:13%; --magnet-strength:6;">
        <span class="hero-icon__bob bob-b" style="--bob-dur:6.1s; --bob-delay:-2.9s;">
          <picture class="hero-icon__img hero-icon__img--closed">
            <source type="image/avif" srcset="/images/hero/sprites/github-closed.avif" />
            <source type="image/webp" srcset="/images/hero/sprites/github-closed.webp" />
            <img src="/images/hero/sprites/github-closed.png" width="400" height="400" alt="" loading="eager" decoding="async" />
          </picture>
          <picture class="hero-icon__img hero-icon__img--open">
            <source type="image/avif" srcset="/images/hero/sprites/github-open.avif" />
            <source type="image/webp" srcset="/images/hero/sprites/github-open.webp" />
            <img src="/images/hero/sprites/github-open.png" width="400" height="400" alt="" loading="eager" decoding="async" />
          </picture>
        </span>
      </a>

      <a class="hero-icon wiggle-sprite" href="mailto:dev.chloe.c@gmail.com" aria-label="Email Chloe"
         style="--x:52.28%; --y:92.18%; --w:10.01%; --x-mobile:62%; --y-mobile:87%; --w-mobile:13%; --magnet-strength:6;">
        <span class="hero-icon__bob bob-c" style="--bob-dur:5.0s; --bob-delay:-3.6s;">
          <picture class="hero-icon__img hero-icon__img--closed">
            <source type="image/avif" srcset="/images/hero/sprites/email-closed.avif" />
            <source type="image/webp" srcset="/images/hero/sprites/email-closed.webp" />
            <img src="/images/hero/sprites/email-closed.png" width="400" height="400" alt="" loading="eager" decoding="async" />
          </picture>
          <picture class="hero-icon__img hero-icon__img--open">
            <source type="image/avif" srcset="/images/hero/sprites/email-open.avif" />
            <source type="image/webp" srcset="/images/hero/sprites/email-open.webp" />
            <img src="/images/hero/sprites/email-open.png" width="400" height="400" alt="" loading="eager" decoding="async" />
          </picture>
        </span>
      </a>

      <a class="hero-icon wiggle-sprite" href="https://www.instagram.com/chloelotus" target="_blank" rel="noopener" aria-label="Chloe on Instagram"
         style="--x:62.66%; --y:89.67%; --w:10.25%; --x-mobile:85%; --y-mobile:91%; --w-mobile:13%; --magnet-strength:6;">
        <span class="hero-icon__bob bob-d" style="--bob-dur:6.8s; --bob-delay:-0.9s;">
          <picture class="hero-icon__img hero-icon__img--closed">
            <source type="image/avif" srcset="/images/hero/sprites/instagram-closed.avif" />
            <source type="image/webp" srcset="/images/hero/sprites/instagram-closed.webp" />
            <img src="/images/hero/sprites/instagram-closed.png" width="400" height="400" alt="" loading="eager" decoding="async" />
          </picture>
          <picture class="hero-icon__img hero-icon__img--open">
            <source type="image/avif" srcset="/images/hero/sprites/instagram-open.avif" />
            <source type="image/webp" srcset="/images/hero/sprites/instagram-open.webp" />
            <img src="/images/hero/sprites/instagram-open.png" width="400" height="400" alt="" loading="eager" decoding="async" />
          </picture>
        </span>
      </a>

    </div>
  </div>
</section>

<script>
  // ─── HERO CLAW: descends toward the bunny as you scroll ───
  // --claw-progress goes 0 (resting, matches hero-preview) → 1 (right as
  // the hero fully scrolls out of frame — rawProgress is exactly 1 at
  // that point, so no speed multiplier here: the claw keeps moving for
  // the entire time the hero is on screen instead of finishing early
  // and sitting still while the rest of the hero scrolls past it.
  // easeInOut gives it a slow-start/slow-finish feel instead of
  // tracking the scrollbar linearly.
  function easeInOut(p: number): number {
    return 0.5 - 0.5 * Math.cos(Math.PI * p);
  }

  const heroSection = document.querySelector('.hero-section') as HTMLElement | null;
  const heroClaw = document.getElementById('heroClaw') as HTMLElement | null;

  if (heroSection && heroClaw) {
    let ticking = false;

    const updateClawProgress = () => {
      const rect = heroSection.getBoundingClientRect();
      const rawProgress = Math.min(1, Math.max(0, -rect.top / rect.height));
      const eased = easeInOut(rawProgress);
      heroClaw.style.setProperty('--claw-progress', eased.toFixed(4));
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateClawProgress);
          ticking = true;
        }
      },
      { passive: true }
    );

    updateClawProgress();
  }

  // Per-sprite scroll-inertia + cursor-magnet motion (the wiggle-sprite
  // behavior) now lives in BaseLayout.astro's shared script, driven by
  // the `.wiggle-sprite` class on these elements — see global.css's
  // "WIGGLE SPRITES" section for the class contract.
</script>
