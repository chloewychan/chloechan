---
interface Props {
  id: string;
  label: string;
  title: string;
  tagline: string;
  position: string;
  timeline: string;
  highlights: string[];
}

const { id, label, title, tagline, position, timeline, highlights } = Astro.props;
---

<section id={id} class="full-page-section flex items-center">
  <div class="max-w-3xl mx-auto w-full px-6 text-center">
    <span class="text-sm tracking-widest uppercase text-[var(--color-brand)] mb-4 block">{label}</span>
    <h2 class="font-serif text-5xl md:text-6xl mb-6">{title}</h2>
    <p class="text-lg text-[var(--color-muted)] mb-8 leading-relaxed">{tagline}</p>
    <div class="space-y-4 text-left max-w-xl mx-auto">
      <p><strong>Position:</strong> {position}</p>
      <p><strong>Timeline:</strong> {timeline}</p>
      {highlights.length > 0 && (
        <ul class="list-disc list-outside pl-5 space-y-1 text-[var(--color-muted)]">
          {highlights.map((point) => <li>{point}</li>)}
        </ul>
      )}
    </div>
  </div>
</section>
