---
// Layout: a full-width header (title + tagline), then carousel and
// reveal-box side by side as their own grid columns.
import ProjectCarousel from './ProjectCarousel.astro';
import ProjectRevealBox from './ProjectRevealBox.astro';

interface Props {
  id: string;
  title: string;
  tagline: string;
  role: string;
  timeline: string;
  technologies: string;
  details: string;
  carouselPlaceholder: string;
  carouselSlides: number;
}

const { id, title, tagline, role, timeline, technologies, details, carouselPlaceholder, carouselSlides } = Astro.props;
---

<section id={id} class="full-page-section flex items-center">
  <div class="max-w-7xl mx-auto w-full px-6">
    <div class="mb-8">
      <span class="text-sm tracking-widest uppercase text-[var(--color-brand)] mb-4 block">Project</span>
      <h2 class="font-serif text-4xl md:text-5xl mb-6">{title}</h2>
      <p class="text-lg text-[var(--color-muted)] mb-8 leading-relaxed max-w-2xl">{tagline}</p>
    </div>

    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="min-w-0">
        <ProjectCarousel placeholder={carouselPlaceholder} slides={carouselSlides} />
      </div>
      <div class="min-w-0">
        <ProjectRevealBox role={role} timeline={timeline} technologies={technologies} details={details} />
      </div>
    </div>
  </div>
</section>
