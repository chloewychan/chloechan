---
// Compositwin-style: rectangles sit in fixed ring "slots" (slot 0 at the
// bottom, always the enlarged one) and the arrows rotate which rectangle
// occupies which slot — the images move, the slots (and which slot is
// biggest) don't. Clicking an image rotates it straight into slot 0 —
// an alternative to the arrows, not a replacement.
import { wiggleVariant } from '../../../lib/wiggleSprite';

interface Props {
  count: number;
  caption: string[]; // one caption per image, shown when that image is in slot 0
  seed?: string; // gives each project's placeholder images their own wiggle personality
}

const { count, caption, seed = 'carousel' } = Astro.props;
const items = Array.from({ length: count }, (_, i) => i);
// Each placeholder image is a wiggle sprite and grows on hover, like the
// rest of the site's clickable art; the arrows that control them are not,
// so they stay put and easy to click.
const variants = items.map((i) => wiggleVariant(`${seed}-carousel-${i}`));
---

<div class="image-carousel carousel-rotate">
  <button type="button" class="carousel-arrow-btn carousel-arrow-btn--left" aria-label="Rotate counterclockwise">
    <img src="/images/general/arrow.png" alt="" />
  </button>

  <div class="carousel-stage">
    {items.map((i) => {
      const v = variants[i];
      const style = `--inertia-kick:${v.kick}; --inertia-friction:${v.friction}; --inertia-max:${v.max}; --bob-dur:${v.bobDur}s; --bob-delay:${v.bobDelay}s;`;
      return (
        <button
          type="button"
          class={`carousel-rect wiggle-sprite hover-expand ${v.bobClass}`}
          style={style}
          data-index={i}
          data-slot={i}
          aria-label={`Show image ${i + 1}`}
        />
      );
    })}
  </div>

  <button type="button" class="carousel-arrow-btn carousel-arrow-btn--right" aria-label="Rotate clockwise">
    <img src="/images/general/arrow.png" alt="" />
  </button>

  <p class="carousel-caption">
    {items.map((i) => (
      <span class="carousel-caption__item" data-index={i}>
        {caption[i] ?? ''}
      </span>
    ))}
  </p>
</div>

<script>
  // Astro dedupes this across every RotatingCarousel instance on the page.
  document.querySelectorAll<HTMLElement>('.carousel-rotate').forEach((carousel) => {
    const rects = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.carousel-rect'));
    const captionItems = Array.from(carousel.querySelectorAll<HTMLElement>('.carousel-caption__item'));
    const count = rects.length;
    const prevBtn = carousel.querySelector('.carousel-arrow-btn--left');
    const nextBtn = carousel.querySelector('.carousel-arrow-btn--right');
    if (!count) return;

    let offset = 0;

    const render = () => {
      rects.forEach((rect, i) => {
        const slot = ((i + offset) % count + count) % count;
        rect.dataset.slot = String(slot);
      });
      // Slot 0 is always the enlarged/selected one; find which original
      // image index currently maps there (inverse of the slot formula
      // above) so its caption is the one shown.
      const activeIndex = ((-offset % count) + count) % count;
      captionItems.forEach((el, i) => el.classList.toggle('active', i === activeIndex));
    };

    const rotateTo = (index: number) => {
      offset = ((-index % count) + count) % count;
      render();
    };

    // Right arrow = clockwise: the bottom (slot 0) image moves out to the
    // right as the next one rotates in from the left to take its place.
    nextBtn?.addEventListener('click', () => {
      offset = (offset + 1) % count;
      render();
    });

    prevBtn?.addEventListener('click', () => {
      offset = (offset - 1 + count) % count;
      render();
    });

    rects.forEach((rect, i) => rect.addEventListener('click', () => rotateTo(i)));

    render();
  });
</script>
